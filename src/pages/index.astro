---

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="WhoseTurn — the household chore tracker that settles the argument. Track chores, earn points, see who's actually pulling their weight." />
    <meta name="theme-color" content="#FFE500" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>WhoseTurn — Whose turn is it anyway?</title>
  </head>
  <body>
    <!-- HERO -->
    <section class="hero">
      <div class="container">
        <div class="hero-badge">HOUSEHOLD ACCOUNTABILITY APP</div>
        <h1>WHOSETURN</h1>
        <p class="hero-tagline">Whose turn is it anyway?</p>
        <p class="hero-desc">
          Stop arguing about who does more around the house.<br />
          Start keeping score.
        </p>
        <a href="https://whoseturnisit.vercel.app/auth" class="btn btn-black">GET STARTED</a>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="section bg-white">
      <div class="container">
        <h2>THE PROBLEM</h2>
        <div class="card-grid">
          <div class="card card-pink">
            <div class="card-icon">🧠</div>
            <h3>SELECTIVE MEMORY</h3>
            <p>Everyone remembers the chores <strong>they</strong> did. Nobody remembers the ones they didn't.</p>
          </div>
          <div class="card card-yellow">
            <div class="card-icon">⚖️</div>
            <h3>INVISIBLE LABOUR</h3>
            <p>Half the work in a household goes unnoticed. If it's not tracked, it didn't happen.</p>
          </div>
          <div class="card card-lime">
            <div class="card-icon">💬</div>
            <h3>THE ARGUMENT</h3>
            <p>"I always do the dishes." "No you don't." Sound familiar? We thought so.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section bg-yellow">
      <div class="container">
        <h2>HOW IT WORKS</h2>
        <div class="steps">
          <div class="step">
            <div class="step-number bg-lime">1</div>
            <div class="step-content">
              <h3>CREATE A GROUP</h3>
              <p>Set up your household and invite your partner, housemates, or whoever you share a bin with.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number bg-pink">2</div>
            <div class="step-content">
              <h3>ADD YOUR CHORES</h3>
              <p>List the jobs that need doing and assign point values. Scrubbing the oven? That's worth more than wiping a counter.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number bg-blue">3</div>
            <div class="step-content">
              <h3>DO THE THING</h3>
              <p>Finished a chore? Mark it done, earn your points. The leaderboard updates in real time.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-number bg-orange">4</div>
            <div class="step-content">
              <h3>LET THE SCORES TALK</h3>
              <p>No more "I think I do more." The numbers are right there. Cold, hard, domestic receipts.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- APP PREVIEW -->
    <section class="section bg-white">
      <div class="container">
        <h2>SEE IT IN ACTION</h2>
        <div class="phone-grid">

          <!-- CHORES SCREEN -->
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-header">
              <span class="phone-title">Our Flat</span>
              <span class="phone-action">+</span>
            </div>
            <div class="phone-filters">
              <span class="pill pill-active">ALL</span>
              <span class="pill">RECURRING</span>
              <span class="pill">ONE-TIME</span>
            </div>
            <div class="phone-body">
              <div class="mock-chore">
                <div class="mock-chore-info">
                  <span class="mock-chore-name">Do the dishes</span>
                  <div class="mock-chore-tags">
                    <span class="mock-tag tag-yellow">15 PTS</span>
                    <span class="mock-tag tag-blue">RECURRING</span>
                  </div>
                </div>
                <span class="mock-check bg-lime">✓</span>
              </div>
              <div class="mock-chore">
                <div class="mock-chore-info">
                  <span class="mock-chore-name">Clean the bathroom</span>
                  <div class="mock-chore-tags">
                    <span class="mock-tag tag-yellow">30 PTS</span>
                    <span class="mock-tag tag-blue">RECURRING</span>
                  </div>
                </div>
                <span class="mock-check bg-lime">✓</span>
              </div>
              <div class="mock-chore">
                <div class="mock-chore-info">
                  <span class="mock-chore-name">Take bins out</span>
                  <div class="mock-chore-tags">
                    <span class="mock-tag tag-yellow">10 PTS</span>
                    <span class="mock-tag tag-orange">ONE-TIME</span>
                  </div>
                </div>
                <span class="mock-check bg-lime">✓</span>
              </div>
              <div class="mock-chore">
                <div class="mock-chore-info">
                  <span class="mock-chore-name">Hoover the flat</span>
                  <div class="mock-chore-tags">
                    <span class="mock-tag tag-yellow">20 PTS</span>
                    <span class="mock-tag tag-blue">RECURRING</span>
                  </div>
                </div>
                <span class="mock-check bg-lime">✓</span>
              </div>
            </div>
            <div class="phone-nav">
              <span class="nav-item nav-active">CHORES</span>
              <span class="nav-item">SCORES</span>
              <span class="nav-item">LOG</span>
              <span class="nav-item">GROUP</span>
            </div>
            <p class="phone-label">CHORES LIST</p>
          </div>

          <!-- LEADERBOARD SCREEN -->
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-header phone-header-yellow">
              <span class="phone-title-center">LEADERBOARD</span>
            </div>
            <div class="phone-body">
              <div class="mock-leader">
                <span class="mock-rank bg-yellow">1</span>
                <div class="mock-avatar" style="background:#FF2D9B;">S</div>
                <div class="mock-leader-info">
                  <span class="mock-leader-name">Sarah</span>
                  <div class="mock-bar"><div class="mock-bar-fill bg-yellow" style="width:100%;"></div></div>
                </div>
                <div class="mock-points">285<span class="mock-pts">PTS</span></div>
              </div>
              <div class="mock-leader">
                <span class="mock-rank bg-pink">2</span>
                <div class="mock-avatar" style="background:#0066FF;">T</div>
                <div class="mock-leader-info">
                  <span class="mock-leader-name">Tom</span>
                  <div class="mock-bar"><div class="mock-bar-fill bg-pink" style="width:68%;"></div></div>
                </div>
                <div class="mock-points">195<span class="mock-pts">PTS</span></div>
              </div>
              <div class="mock-leader">
                <span class="mock-rank bg-lime">3</span>
                <div class="mock-avatar" style="background:#FF6B00;">J</div>
                <div class="mock-leader-info">
                  <span class="mock-leader-name">Jake</span>
                  <div class="mock-bar"><div class="mock-bar-fill bg-lime" style="width:39%;"></div></div>
                </div>
                <div class="mock-points">110<span class="mock-pts">PTS</span></div>
              </div>
            </div>
            <div class="phone-nav">
              <span class="nav-item">CHORES</span>
              <span class="nav-item nav-active">SCORES</span>
              <span class="nav-item">LOG</span>
              <span class="nav-item">GROUP</span>
            </div>
            <p class="phone-label">LEADERBOARD</p>
          </div>

          <!-- ACTIVITY SCREEN -->
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-header phone-header-orange">
              <span class="phone-title-center">ACTIVITY</span>
            </div>
            <div class="phone-body">
              <div class="mock-date-label">TODAY</div>
              <div class="mock-activity">
                <div class="mock-avatar-sm" style="background:#FF2D9B;">S</div>
                <div class="mock-activity-info">
                  <span><strong>Sarah</strong> completed <strong>Do the dishes</strong></span>
                  <span class="mock-time">2m ago</span>
                </div>
                <span class="mock-tag tag-yellow">+15</span>
              </div>
              <div class="mock-activity">
                <div class="mock-avatar-sm" style="background:#0066FF;">T</div>
                <div class="mock-activity-info">
                  <span><strong>Tom</strong> completed <strong>Take bins out</strong></span>
                  <span class="mock-time">1h ago</span>
                </div>
                <span class="mock-tag tag-yellow">+10</span>
              </div>
              <div class="mock-date-label">YESTERDAY</div>
              <div class="mock-activity">
                <div class="mock-avatar-sm" style="background:#FF2D9B;">S</div>
                <div class="mock-activity-info">
                  <span><strong>Sarah</strong> completed <strong>Hoover the flat</strong></span>
                  <span class="mock-time">1d ago</span>
                </div>
                <span class="mock-tag tag-yellow">+20</span>
              </div>
              <div class="mock-activity">
                <div class="mock-avatar-sm" style="background:#FF6B00;">J</div>
                <div class="mock-activity-info">
                  <span><strong>Jake</strong> completed <strong>Clean the bathroom</strong></span>
                  <span class="mock-time">1d ago</span>
                </div>
                <span class="mock-tag tag-yellow">+30</span>
              </div>
            </div>
            <div class="phone-nav">
              <span class="nav-item">CHORES</span>
              <span class="nav-item">SCORES</span>
              <span class="nav-item nav-active">LOG</span>
              <span class="nav-item">GROUP</span>
            </div>
            <p class="phone-label">ACTIVITY LOG</p>
          </div>

        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="section bg-yellow">
      <div class="container">
        <h2>FEATURES</h2>
        <div class="card-grid four">
          <div class="feature">
            <div class="feature-icon bg-lime">✓</div>
            <h3>REAL-TIME SCORES</h3>
            <p>Points update instantly. No refresh needed.</p>
          </div>
          <div class="feature">
            <div class="feature-icon bg-yellow">📋</div>
            <h3>ACTIVITY LOG</h3>
            <p>Full history of who did what and when. Receipts.</p>
          </div>
          <div class="feature">
            <div class="feature-icon bg-pink">🏆</div>
            <h3>LEADERBOARD</h3>
            <p>See who's on top. Friendly competition encouraged.</p>
          </div>
          <div class="feature">
            <div class="feature-icon bg-blue">🔄</div>
            <h3>RECURRING & ONE-TIME</h3>
            <p>Set chores as recurring or one-off. They disappear when done.</p>
          </div>
          <div class="feature">
            <div class="feature-icon bg-orange">👥</div>
            <h3>GROUPS</h3>
            <p>Invite anyone with a code. Works for couples, flatshares, families.</p>
          </div>
          <div class="feature">
            <div class="feature-icon bg-lime">📱</div>
            <h3>MOBILE FIRST</h3>
            <p>Designed for your phone. Add to home screen for the full experience.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section bg-black">
      <div class="container cta">
        <h2 class="text-white">READY TO SETTLE IT?</h2>
        <p class="text-white-muted">Free. No ads. Just accountability.</p>
        <a href="https://whoseturnisit.vercel.app/auth" class="btn btn-yellow">START TRACKING</a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="container footer-inner">
        <span class="footer-brand">WHOSETURN</span>
        <span class="footer-copy">Made with spite and good intentions.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ================================
     RESET & BASE
     ================================ */
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    background: #FFFFFF;
    color: #000000;
    -webkit-font-smoothing: antialiased;
  }

  /* ================================
     COLORS
     ================================ */
  .bg-yellow { background: #FFE500; }
  .bg-lime { background: #BFFF00; }
  .bg-pink { background: #FF2D9B; color: #FFFFFF; }
  .bg-blue { background: #0066FF; color: #FFFFFF; }
  .bg-orange { background: #FF6B00; color: #FFFFFF; }
  .bg-black { background: #000000; }
  .bg-white { background: #FFFFFF; }
  .text-white { color: #FFFFFF; }
  .text-white-muted { color: rgba(255,255,255,0.6); font-size: 0.875rem; }

  /* ================================
     LAYOUT
     ================================ */
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section h2 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  /* ================================
     HERO
     ================================ */
  .hero {
    background: #FFE500;
    border-bottom: 4px solid #000;
    padding: 5rem 0 4rem;
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 2px;
    background: #000;
    color: #FFE500;
    padding: 0.4rem 1rem;
    margin-bottom: 1.5rem;
    border: 2px solid #000;
  }

  .hero h1 {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    font-size: 1rem;
    font-weight: 600;
    opacity: 0.6;
    margin-bottom: 1.5rem;
  }

  .hero-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
    max-width: 400px;
    margin: 0 auto 2rem;
  }

  /* ================================
     BUTTONS
     ================================ */
  .btn {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.875rem 2rem;
    border: 3px solid #000;
    box-shadow: 6px 6px 0 0 #000;
    transition: all 0.1s ease;
    cursor: pointer;
  }

  .btn:hover {
    box-shadow: 3px 3px 0 0 #000;
    transform: translate(3px, 3px);
  }

  .btn:active {
    box-shadow: none;
    transform: translate(6px, 6px);
  }

  .btn-black {
    background: #000;
    color: #FFE500;
  }

  .btn-yellow {
    background: #FFE500;
    color: #000;
  }

  /* ================================
     CARDS
     ================================ */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .card-grid.four {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .card {
    border: 3px solid #000;
    box-shadow: 6px 6px 0 0 #000;
    padding: 1.5rem;
  }

  .card-pink { background: #FF2D9B; color: #FFF; }
  .card-yellow { background: #FFE500; }
  .card-lime { background: #BFFF00; }

  .card-icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .card h3 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
  }

  .card p {
    font-size: 0.75rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  /* ================================
     STEPS
     ================================ */
  .steps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #FFF;
    border: 3px solid #000;
    box-shadow: 6px 6px 0 0 #000;
    padding: 1.25rem;
  }

  .step-number {
    width: 48px;
    height: 48px;
    min-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    border: 3px solid #000;
  }

  .step-content h3 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 0.25rem;
  }

  .step-content p {
    font-size: 0.75rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* ================================
     PHONE MOCKUPS
     ================================ */
  .phone-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    justify-items: center;
  }

  .phone {
    width: 100%;
    max-width: 220px;
    background: #FFF;
    border: 3px solid #000;
    box-shadow: 8px 8px 0 0 #000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
  }

  .phone-notch {
    width: 60px;
    height: 6px;
    background: #000;
    border-radius: 3px;
    margin: 8px auto 4px;
  }

  .phone-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 3px solid #000;
    background: #FFF;
  }

  .phone-header-yellow { background: #FFE500; }
  .phone-header-orange { background: #FF6B00; }

  .phone-title {
    font-size: 0.7rem;
    font-weight: 700;
  }

  .phone-title-center {
    font-size: 0.7rem;
    font-weight: 700;
    width: 100%;
    text-align: center;
  }

  .phone-header-orange .phone-title-center {
    color: #FFF;
  }

  .phone-action {
    width: 24px;
    height: 24px;
    background: #0066FF;
    color: #FFF;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .phone-filters {
    display: flex;
    gap: 4px;
    padding: 8px 10px;
  }

  .pill {
    font-size: 0.45rem;
    font-weight: 700;
    padding: 3px 8px;
    border: 2px solid #000;
    background: #FFF;
  }

  .pill-active {
    background: #000;
    color: #FFF;
  }

  .phone-body {
    flex: 1;
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 200px;
  }

  .phone-nav {
    display: flex;
    border-top: 3px solid #000;
  }

  .nav-item {
    flex: 1;
    text-align: center;
    font-size: 0.4rem;
    font-weight: 700;
    padding: 6px 0;
    letter-spacing: 0.5px;
    color: rgba(0,0,0,0.4);
  }

  .nav-active {
    background: #FFE500;
    color: #000;
  }

  .phone-label {
    text-align: center;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1px;
    margin-top: 1rem;
    opacity: 0.4;
  }

  /* Mock chore items */
  .mock-chore {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 0 #000;
    background: #FFF;
  }

  .mock-chore-info {
    flex: 1;
    min-width: 0;
  }

  .mock-chore-name {
    font-size: 0.55rem;
    font-weight: 700;
    display: block;
    margin-bottom: 3px;
  }

  .mock-chore-tags {
    display: flex;
    gap: 3px;
  }

  .mock-tag {
    font-size: 0.4rem;
    font-weight: 700;
    padding: 1px 4px;
    border: 1px solid #000;
  }

  .tag-yellow { background: #FFE500; }
  .tag-blue { background: rgba(0,102,255,0.1); color: #0066FF; border-color: #0066FF; }
  .tag-orange { background: rgba(255,107,0,0.1); color: #FF6B00; border-color: #FF6B00; }

  .mock-check {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 700;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 0 #000;
    flex-shrink: 0;
  }

  /* Mock leaderboard */
  .mock-leader {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 0 #000;
    background: #FFF;
  }

  .mock-rank {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6rem;
    font-weight: 700;
    border: 2px solid #000;
    flex-shrink: 0;
  }

  .mock-avatar {
    width: 24px;
    height: 24px;
    border-radius: 0;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.5rem;
    font-weight: 700;
    color: #FFF;
    flex-shrink: 0;
  }

  .mock-avatar-sm {
    width: 20px;
    height: 20px;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.4rem;
    font-weight: 700;
    color: #FFF;
    flex-shrink: 0;
  }

  .mock-leader-info {
    flex: 1;
    min-width: 0;
  }

  .mock-leader-name {
    font-size: 0.5rem;
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }

  .mock-bar {
    height: 4px;
    background: rgba(0,0,0,0.1);
    border: 1px solid rgba(0,0,0,0.15);
  }

  .mock-bar-fill {
    height: 100%;
  }

  .mock-points {
    font-size: 0.7rem;
    font-weight: 700;
    text-align: right;
    min-width: 30px;
  }

  .mock-pts {
    display: block;
    font-size: 0.35rem;
    opacity: 0.4;
  }

  /* Mock activity */
  .mock-date-label {
    font-size: 0.4rem;
    font-weight: 700;
